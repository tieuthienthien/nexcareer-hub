{
  "name": "SavedJob",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "ID v\u1ecb tr\u00ed vi\u1ec7c l\u00e0m \u0111\u00e3 l\u01b0u"
    },
    "job_title": {
      "type": "string",
      "description": "T\u00ean v\u1ecb tr\u00ed (snapshot)"
    },
    "company": {
      "type": "string",
      "description": "T\u00ean c\u00f4ng ty (snapshot)"
    },
    "company_logo": {
      "type": "string",
      "description": "URL logo c\u00f4ng ty (n\u1ebfu c\u00f3)"
    }
  },
  "required": [
    "job_id",
    "job_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}