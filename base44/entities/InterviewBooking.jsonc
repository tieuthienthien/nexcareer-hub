{
  "name": "InterviewBooking",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "slot_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string",
      "description": "User id c\u1ee7a \u1ee9ng vi\u00ean (n\u1ebfu c\u00f3)"
    },
    "candidate_name": {
      "type": "string"
    },
    "candidate_email": {
      "type": "string"
    },
    "interviewer_name": {
      "type": "string"
    },
    "interviewer_email": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "online",
        "onsite"
      ],
      "default": "online"
    },
    "location": {
      "type": "string"
    },
    "meeting_link": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "duration_min": {
      "type": "number",
      "default": 45
    },
    "status": {
      "type": "string",
      "enum": [
        "booked",
        "cancelled",
        "completed"
      ],
      "default": "booked"
    },
    "rescheduled_count": {
      "type": "number",
      "default": 0
    },
    "reminder_24_sent": {
      "type": "boolean",
      "default": false
    },
    "reminder_1_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "application_id",
    "slot_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.candidate_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}