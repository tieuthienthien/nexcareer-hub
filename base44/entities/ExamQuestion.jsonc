{
  "name": "ExamQuestion",
  "type": "object",
  "properties": {
    "group": {
      "type": "string",
      "enum": [
        "lap-trinh",
        "ux-ui",
        "iot",
        "hr"
      ],
      "default": "lap-trinh",
      "description": "Nh\u00f3m \u0111\u1ec1 theo v\u1ecb tr\u00ed"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Th\u1ee9 t\u1ef1 trong ng\u00e2n h\u00e0ng \u0111\u1ec1 (\u0111\u1ed9 kh\u00f3 t\u0103ng d\u1ea7n)"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "easy"
    },
    "type": {
      "type": "string",
      "enum": [
        "mcq",
        "short",
        "code"
      ],
      "default": "short"
    },
    "title": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "description": "\u0110\u1ec1 b\u00e0i"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "none",
        "image",
        "video"
      ],
      "default": "none"
    },
    "media_url": {
      "type": "string",
      "description": "\u1ea2nh/video m\u00f4 ph\u1ecfng t\u00ecnh hu\u1ed1ng"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ph\u01b0\u01a1ng \u00e1n cho c\u00e2u tr\u1eafc nghi\u1ec7m"
    },
    "answer": {
      "type": "string",
      "description": "\u0110\u00e1p \u00e1n \u0111\u00fang (tr\u1eafc nghi\u1ec7m)"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "T\u1eeb kh\u00f3a ch\u1ea5p nh\u1eadn cho c\u00e2u t\u1ef1 lu\u1eadn"
    },
    "points": {
      "type": "number",
      "default": 10
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "group",
    "prompt"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}