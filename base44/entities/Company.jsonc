{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "T\u00ean c\u00f4ng ty"
    },
    "industry": {
      "type": "string",
      "description": "Ng\u00e0nh ngh\u1ec1"
    },
    "size": {
      "type": "string",
      "description": "Quy m\u00f4 nh\u00e2n s\u1ef1"
    },
    "description": {
      "type": "string",
      "description": "Gi\u1edbi thi\u1ec7u c\u00f4ng ty"
    },
    "website": {
      "type": "string",
      "description": "Trang web c\u00f4ng ty"
    },
    "is_nexora": {
      "type": "boolean",
      "default": false,
      "description": "C\u00f4ng ty Nexora Technology \u2014 h\u1ed3 s\u01a1 n\u1ed9p v\u00e0o s\u1ebd \u0111\u1ed3ng b\u1ed9 sang NexCareer Hub"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}