{
  "name": "CvApplication",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "ID tin tuy\u1ec3n d\u1ee5ng tr\u00ean n\u1ec1n t\u1ea3ng CV"
    },
    "job_title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "is_nexora": {
      "type": "boolean",
      "default": false,
      "description": "H\u1ed3 s\u01a1 \u0111\u01b0\u1ee3c \u0111\u1ed3ng b\u1ed9 sang NexCareer Hub"
    },
    "cv_document_id": {
      "type": "string",
      "description": "Phi\u00ean b\u1ea3n CV \u0111\u00e3 d\u00f9ng \u0111\u1ec3 \u1ee9ng tuy\u1ec3n"
    },
    "cv_title": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "cover_letter": {
      "type": "string"
    },
    "cv_snapshot": {
      "type": "string",
      "description": "B\u1ea3n ch\u1ee5p n\u1ed9i dung CV t\u1ea1i th\u1eddi \u0111i\u1ec3m \u1ee9ng tuy\u1ec3n"
    },
    "synced": {
      "type": "boolean",
      "default": false,
      "description": "\u0110\u00e3 t\u1ea1o h\u1ed3 s\u01a1 t\u01b0\u01a1ng \u1ee9ng trong NexCareer Hub"
    },
    "hub_application_id": {
      "type": "string",
      "description": "ID h\u1ed3 s\u01a1 \u1ee9ng tuy\u1ec3n trong NexCareer Hub"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_review",
        "closed"
      ],
      "default": "submitted"
    }
  },
  "required": [
    "job_id",
    "job_title",
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}