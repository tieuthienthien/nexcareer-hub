{
  "name": "SocialPost",
  "type": "object",
  "description": "B\u00e0i truy\u1ec1n th\u00f4ng tuy\u1ec3n d\u1ee5ng do HR t\u1ea1o v\u00e0 \u0111\u1eb7t l\u1ecbch \u0111\u0103ng cho t\u1eebng vi\u1ec7c l\u00e0m",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Vi\u1ec7c l\u00e0m \u0111\u01b0\u1ee3c truy\u1ec1n th\u00f4ng"
    },
    "job_title": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "linkedin",
        "facebook",
        "topcv",
        "x"
      ],
      "default": "linkedin"
    },
    "style": {
      "type": "string",
      "enum": [
        "professional",
        "youthful",
        "concise"
      ],
      "default": "professional"
    },
    "title": {
      "type": "string",
      "description": "Ti\u00eau \u0111\u1ec1 b\u00e0i \u0111\u0103ng"
    },
    "content": {
      "type": "string",
      "description": "N\u1ed9i dung b\u00e0i \u0111\u0103ng"
    },
    "image_url": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m d\u1ef1 ki\u1ebfn \u0111\u0103ng (ISO)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "posted",
        "cancelled"
      ],
      "default": "draft"
    },
    "posted_at": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}