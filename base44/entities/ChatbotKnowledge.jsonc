{
  "name": "ChatbotKnowledge",
  "type": "object",
  "properties": {
    "intent_id": {
      "type": "string",
      "description": "M\u00e3 \u0111\u1ecbnh danh duy\u00ean nh\u1ea5t c\u1ee7a intent (VD: r1.score.meaning)"
    },
    "question": {
      "type": "string",
      "description": "C\u00e2u h\u1ecfi m\u1eabu ch\u00ednh (canonical)"
    },
    "answer": {
      "type": "string",
      "description": "C\u00e2u tr\u1ea3 l\u1eddi ti\u1ebfng Vi\u1ec7t"
    },
    "answer_en": {
      "type": "string",
      "description": "C\u00e2u tr\u1ea3 l\u1eddi ti\u1ebfng Anh (d\u1ef1 ph\u00f2ng)"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "C\u00e1c c\u00e1ch h\u1ecfi thay th\u1ebf / \u0111\u1ed3ng ngh\u0129a / vi\u1ebft t\u1eaft"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "T\u1eeb kh\u00f3a gi\u00fap ph\u00e2n lo\u1ea1i c\u00e2u h\u1ecfi"
    },
    "category": {
      "type": "string",
      "description": "Nh\u00f3m ch\u1ee7 \u0111\u1ec1 (A\u2013P)"
    },
    "subcategory": {
      "type": "string",
      "description": "Nh\u00f3m con chi ti\u1ebft h\u01a1n"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "all",
        "candidate",
        "recruiter",
        "hiring_manager",
        "public"
      ],
      "default": "all"
    },
    "answer_type": {
      "type": "string",
      "enum": [
        "static",
        "database",
        "rule_based",
        "ai_required"
      ],
      "default": "static"
    },
    "related_intents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page_link": {
      "type": "string",
      "description": "Trang/h\u00e0nh \u0111\u1ed9ng li\u00ean quan trong app"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "B\u1eadt/t\u1eaft m\u1ee5c ki\u1ebfn th\u1ee9c n\u00e0y"
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}