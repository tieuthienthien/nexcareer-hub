{
  "name": "CalendarToken",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "description": "Email HR \u0111\u00e3 k\u1ebft n\u1ed1i Google Calendar"
    },
    "google_email": {
      "type": "string",
      "description": "T\u00e0i kho\u1ea3n Google th\u1ef1c t\u1ebf nh\u1eadn l\u1eddi m\u1eddi"
    },
    "access_token": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m access token h\u1ebft h\u1ea1n (ISO)"
    },
    "scope": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}