{
  "name": "JobRole",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00ean v\u1ecb tr\u00ed tuy\u1ec3n d\u1ee5ng (kh\u1edbp v\u1edbi t\u00ean v\u1ecb tr\u00ed tr\u00ean tin tuy\u1ec3n d\u1ee5ng)"
    },
    "department": {
      "type": "string",
      "description": "Ph\u00f2ng ban"
    },
    "line_manager_email": {
      "type": "string",
      "format": "email",
      "description": "Email Line Manager ph\u1ee5 tr\u00e1ch v\u1ecb tr\u00ed n\u00e0y"
    },
    "manager_name": {
      "type": "string",
      "description": "T\u00ean Line Manager"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open",
      "description": "\u0110ang tuy\u1ec3n / \u0111\u00e3 \u0111\u00f3ng"
    },
    "headcount": {
      "type": "number",
      "default": 1,
      "description": "S\u1ed1 l\u01b0\u1ee3ng c\u1ea7n tuy\u1ec3n"
    },
    "job_id": {
      "type": "string",
      "description": "Li\u00ean k\u1ebft t\u1edbi tin tuy\u1ec3n d\u1ee5ng (n\u1ebfu c\u00f3)"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}