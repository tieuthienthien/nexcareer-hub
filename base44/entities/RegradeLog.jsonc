{
  "name": "RegradeLog",
  "type": "object",
  "description": "L\u1ecbch s\u1eed c\u00e1c l\u1ea7n HR cho AI ch\u1ea5m l\u1ea1i b\u00e0i l\u00e0m c\u1ee7a \u1ee9ng vi\u00ean (\u0111i\u1ec3m c\u0169 \u2192 \u0111i\u1ec3m m\u1edbi) \u0111\u1ec3 \u0111\u1ed1i chi\u1ebfu. Kh\u00f4ng \u1ea3nh h\u01b0\u1edfng \u0110i\u1ec3m HR.",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "round": {
      "type": "string",
      "enum": [
        "cv",
        "simulation",
        "interview"
      ]
    },
    "old_score": {
      "type": "number"
    },
    "new_score": {
      "type": "number"
    },
    "note": {
      "type": "string",
      "description": "Nh\u1eadn x\u00e9t t\u00f3m t\u1eaft c\u1ee7a l\u1ea7n ch\u1ea5m l\u1ea1i"
    },
    "regraded_by_email": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m ch\u1ea5m l\u1ea1i (ISO)"
    }
  },
  "required": [
    "application_id",
    "round"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}