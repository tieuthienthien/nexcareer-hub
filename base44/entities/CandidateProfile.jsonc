{
  "name": "CandidateProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "headline": {
      "type": "string",
      "description": "Ch\u1ee9c danh / ti\u00eau \u0111\u1ec1 h\u1ed3 s\u01a1"
    },
    "bio": {
      "type": "string",
      "description": "Gi\u1edbi thi\u1ec7u b\u1ea3n th\u00e2n"
    },
    "avatar_uri": {
      "type": "string",
      "description": "URI \u1ea3nh \u0111\u1ea1i di\u1ec7n c\u1ee7a \u1ee9ng vi\u00ean (ri\u00eang t\u01b0, ch\u1ec9 \u1ee9ng vi\u00ean v\u00e0 HR xem qua link t\u1ea1m)"
    },
    "cv_file_uri": {
      "type": "string",
      "description": "URI file CV (ri\u00eang t\u01b0)"
    },
    "cv_source_url": {
      "type": "string",
      "description": "Link CV \u0111\u00e3 n\u1ed9p tr\u00ean h\u1ec7 th\u1ed1ng ngu\u1ed3n (TopCV), hi\u1ec3n th\u1ecb s\u1eb5n trong t\u00e0i kho\u1ea3n \u1ee9ng vi\u00ean"
    },
    "portfolio_url": {
      "type": "string",
      "description": "Link portfolio"
    },
    "english_certificate": {
      "type": "string",
      "description": "Ch\u1ee9ng ch\u1ec9 ti\u1ebfng Anh (VD: IELTS 7.0, TOEIC 850)"
    },
    "github_url": {
      "type": "string",
      "description": "Link GitHub"
    },
    "project_links": {
      "type": "string",
      "description": "Link d\u1ef1 \u00e1n / website / \u1ee9ng d\u1ee5ng \u0111\u00e3 l\u00e0m, m\u1ed7i d\u00f2ng m\u1ed9t link"
    },
    "certificate_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Danh s\u00e1ch URI file ch\u1ee9ng ch\u1ec9 (ri\u00eang t\u01b0)"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience_years": {
      "type": "number"
    },
    "education": {
      "type": "string"
    },
    "location": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}