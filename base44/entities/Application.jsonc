{
  "name": "Application",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "ID v\u1ecb tr\u00ed \u1ee9ng tuy\u1ec3n"
    },
    "job_title": {
      "type": "string",
      "description": "T\u00ean v\u1ecb tr\u00ed (snapshot)"
    },
    "company": {
      "type": "string",
      "description": "T\u00ean c\u00f4ng ty (snapshot)"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "english_certificate": {
      "type": "string",
      "description": "Ch\u1ee9ng ch\u1ec9 ti\u1ebfng Anh (VD: IELTS 7.0, TOEIC 850)"
    },
    "cv_file_uri": {
      "type": "string",
      "description": "URI file CV (ri\u00eang t\u01b0)"
    },
    "cv_source_url": {
      "type": "string",
      "description": "Link CV g\u1ed1c do ngu\u1ed3n ngo\u00e0i cung c\u1ea5p"
    },
    "certificate_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Danh s\u00e1ch URI file ch\u1ee9ng ch\u1ec9 k\u00e8m theo (ri\u00eang t\u01b0)"
    },
    "github_url": {
      "type": "string",
      "description": "Link GitHub / d\u1ef1 \u00e1n \u0111\u00e3 l\u00e0m"
    },
    "portfolio_url": {
      "type": "string",
      "description": "Link portfolio"
    },
    "cover_letter": {
      "type": "string",
      "description": "Th\u01b0 \u1ee9ng tuy\u1ec3n / th\u01b0 gi\u1edbi thi\u1ec7u"
    },
    "cv_source": {
      "type": "string",
      "description": "Ngu\u1ed3n h\u1ed3 s\u01a1: nexcareer ho\u1eb7c t\u00ean ngu\u1ed3n \u0111\u1ed3ng b\u1ed9"
    },
    "cv_document_id": {
      "type": "string",
      "description": "ID CV tr\u00ean n\u1ec1n t\u1ea3ng ngu\u1ed3n (n\u1ebfu c\u00f3)"
    },
    "cv_snapshot": {
      "type": "string",
      "description": "N\u1ed9i dung CV \u0111\u1ed3ng b\u1ed9 t\u1eeb ngu\u1ed3n"
    },
    "external_id": {
      "type": "string",
      "description": "M\u00e3 h\u1ed3 s\u01a1 g\u1ed1c tr\u00ean h\u1ec7 th\u1ed1ng ngu\u1ed3n (tr\u00e1nh t\u1ea1o tr\u00f9ng khi \u0111\u1ed3ng b\u1ed9)"
    },
    "external_source": {
      "type": "string",
      "description": "Ngu\u1ed3n \u0111\u1ed3ng b\u1ed9 c\u1ee7a h\u1ed3 s\u01a1 (VD: topcvxme)"
    },
    "last_synced_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m \u0111\u1ed3ng b\u1ed9 g\u1ea7n nh\u1ea5t t\u1eeb ngu\u1ed3n (ISO)"
    },
    "needs_review": {
      "type": "boolean",
      "default": false,
      "description": "H\u1ed3 s\u01a1 c\u1ea7n HR r\u00e0 so\u00e1t: thi\u1ebfu th\u00f4ng tin t\u1eeb ngu\u1ed3n ho\u1eb7c ch\u01b0a gh\u00e9p \u0111\u01b0\u1ee3c tin tuy\u1ec3n d\u1ee5ng"
    },
    "status": {
      "type": "string",
      "enum": [
        "cv_screening",
        "cv_passed",
        "cv_rejected",
        "test_invited",
        "test_submitted",
        "test_passed",
        "test_rejected",
        "interview_invited",
        "scheduled",
        "interview_submitted",
        "final_review",
        "hired",
        "rejected"
      ],
      "default": "cv_screening"
    },
    "notes": {
      "type": "string",
      "description": "Ghi ch\u00fa n\u1ed9i b\u1ed9 c\u1ee7a HR"
    },
    "confirmation_sent_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m g\u1eedi email x\u00e1c nh\u1eadn \u0111\u00e3 nh\u1eadn h\u1ed3 s\u01a1"
    },
    "cv_match_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m ph\u00f9 h\u1ee3p CV theo barem (0-100)"
    },
    "cv_ai_analysis": {
      "type": "string",
      "description": "Nh\u1eadn x\u00e9t AI v\u00f2ng s\u00e0ng l\u1ecdc CV"
    },
    "cv_strengths": {
      "type": "string",
      "description": "\u0110i\u1ec3m m\u1ea1nh d\u1ef1a tr\u00ean b\u1eb1ng ch\u1ee9ng t\u1eeb CV"
    },
    "cv_gaps": {
      "type": "string",
      "description": "Kho\u1ea3ng tr\u1ed1ng / th\u00f4ng tin thi\u1ebfu ho\u1eb7c ch\u01b0a x\u00e1c minh"
    },
    "cv_quality_signals": {
      "type": "string",
      "description": "T\u00edn hi\u1ec7u ch\u1ea5t l\u01b0\u1ee3ng / \u0111\u00e1nh gi\u00e1 t\u00ednh x\u00e1c th\u1ef1c c\u1ee7a CV"
    },
    "cv_advice": {
      "type": "string",
      "enum": [
        "pass",
        "reject",
        "borderline"
      ],
      "description": "\u0110\u1ec1 xu\u1ea5t c\u1ee7a AI (HR quy\u1ebft \u0111\u1ecbnh cu\u1ed1i)"
    },
    "cv_rubric": {
      "type": "array",
      "description": "B\u1ea3ng \u0111\u1ed1i chi\u1ebfu nh\u00e3n barem v\u1edbi CV",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "band": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "matched": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "cv_required_missing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nh\u00e3n b\u1eaft bu\u1ed9c ch\u01b0a \u0111\u00e1p \u1ee9ng"
    },
    "cv_certificates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ch\u1ee9ng ch\u1ec9 h\u1ee3p l\u1ec7 ghi nh\u1eadn \u0111\u01b0\u1ee3c, g\u1ed3m ch\u1ee9ng ch\u1ec9 do Nexora c\u1ea5p"
    },
    "hr_decision_reason": {
      "type": "string",
      "description": "L\u00fd do HR duy\u1ec7t/t\u1eeb ch\u1ed1i \u1edf v\u00f2ng 1"
    },
    "round1_decided_at": {
      "type": "string"
    },
    "round2_decided_at": {
      "type": "string"
    },
    "exam_attempt_id": {
      "type": "string",
      "description": "B\u00e0i thi v\u00f2ng 2 c\u1ee7a \u1ee9ng vi\u00ean"
    },
    "test_answer": {
      "type": "string",
      "description": "B\u00e0i l\u00e0m v\u00f2ng 2 d\u1ea1ng v\u0103n b\u1ea3n (c\u1ea5u h\u00ecnh c\u0169)"
    },
    "test_started_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m b\u1eaft \u0111\u1ea7u l\u00e0m b\u00e0i thi (ISO)"
    },
    "test_submitted_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m n\u1ed9p b\u00e0i thi (ISO)"
    },
    "test_auto_submitted": {
      "type": "boolean",
      "default": false
    },
    "test_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m AI ch\u1ea5m b\u00e0i thi (0-100)"
    },
    "test_ai_analysis": {
      "type": "string",
      "description": "Nh\u1eadn x\u00e9t AI v\u00f2ng thi"
    },
    "interview_booking_id": {
      "type": "string"
    },
    "interview_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m ph\u1ecfng v\u1ea5n \u0111\u00e3 \u0111\u1eb7t (ISO)"
    },
    "interview_submitted_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m ho\u00e0n t\u1ea5t ph\u1ecfng v\u1ea5n (ISO)"
    },
    "interview_ai_analysis": {
      "type": "string",
      "description": "Nh\u1eadn x\u00e9t AI ph\u1ecfng v\u1ea5n"
    },
    "interview_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m AI ph\u1ecfng v\u1ea5n (0-100)"
    },
    "final_result": {
      "type": "string",
      "enum": [
        "hired",
        "rejected",
        "review"
      ],
      "description": "K\u1ebft qu\u1ea3 cu\u1ed1i sau ph\u1ecfng v\u1ea5n"
    },
    "final_result_note": {
      "type": "string",
      "description": "Ghi ch\u00fa k\u1ebft qu\u1ea3 cu\u1ed1i"
    },
    "final_notes": {
      "type": "string",
      "description": "Ghi ch\u00fa quy\u1ebft \u0111\u1ecbnh cu\u1ed1i c\u1ee7a h\u1ed9i \u0111\u1ed3ng"
    },
    "schedule_nudge_sent_at": {
      "type": "string",
      "description": "\u0110\u00e3 nh\u1eafc \u1ee9ng vi\u00ean ch\u1ecdn l\u1ecbch ph\u1ecfng v\u1ea5n"
    },
    "schedule_hr_alerted_at": {
      "type": "string",
      "description": "\u0110\u00e3 b\u00e1o HR v\u1ec1 h\u1ed3 s\u01a1 qu\u00e1 h\u1ea1n ch\u1ecdn l\u1ecbch"
    }
  },
  "required": [
    "job_id",
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}