{
  "name": "Application",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "ID v\u1ecb tr\u00ed \u1ee9ng tuy\u1ec3n"
    },
    "job_title": {
      "type": "string",
      "description": "T\u00ean v\u1ecb tr\u00ed (snapshot)"
    },
    "company": {
      "type": "string",
      "description": "T\u00ean c\u00f4ng ty (snapshot)"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "cv_file_uri": {
      "type": "string",
      "description": "URI file CV \u0111\u00e3 upload (ri\u00eang t\u01b0)"
    },
    "portfolio_url": {
      "type": "string",
      "description": "Link portfolio"
    },
    "cover_letter": {
      "type": "string",
      "description": "Th\u01b0 \u1ee9ng tuy\u1ec3n"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "interview",
        "offer",
        "rejected",
        "hired"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string",
      "description": "Ghi ch\u00fa n\u1ed9i b\u1ed9 c\u1ee7a HR"
    }
  },
  "required": [
    "job_id",
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}