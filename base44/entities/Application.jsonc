{
  "name": "Application",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "ID v\u1ecb tr\u00ed \u1ee9ng tuy\u1ec3n"
    },
    "job_title": {
      "type": "string",
      "description": "T\u00ean v\u1ecb tr\u00ed (snapshot)"
    },
    "company": {
      "type": "string",
      "description": "T\u00ean c\u00f4ng ty (snapshot)"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "cv_file_uri": {
      "type": "string",
      "description": "URI file CV (ri\u00eang t\u01b0)"
    },
    "portfolio_url": {
      "type": "string",
      "description": "Link portfolio"
    },
    "cover_letter": {
      "type": "string",
      "description": "Th\u01b0 \u1ee9ng tuy\u1ec3n"
    },
    "cv_source": {
      "type": "string",
      "description": "Ngu\u1ed3n h\u1ed3 s\u01a1: nexcareer ho\u1eb7c cv_platform"
    },
    "cv_document_id": {
      "type": "string",
      "description": "ID CV tr\u00ean n\u1ec1n t\u1ea3ng CV (n\u1ebfu n\u1ed9p t\u1eeb n\u1ec1n t\u1ea3ng CV)"
    },
    "cv_snapshot": {
      "type": "string",
      "description": "N\u1ed9i dung CV \u0111\u1ed3ng b\u1ed9 t\u1eeb n\u1ec1n t\u1ea3ng CV"
    },
    "status": {
      "type": "string",
      "enum": [
        "cv_screening",
        "cv_passed",
        "cv_rejected",
        "test_invited",
        "test_submitted",
        "test_passed",
        "test_rejected",
        "interview_invited",
        "interview_submitted",
        "hired",
        "rejected"
      ],
      "default": "cv_screening"
    },
    "notes": {
      "type": "string",
      "description": "Ghi ch\u00fa n\u1ed9i b\u1ed9 c\u1ee7a HR"
    },
    "cv_match_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m ph\u00f9 h\u1ee3p CV theo AI (0-100)"
    },
    "cv_ai_analysis": {
      "type": "string",
      "description": "Nh\u1eadn x\u00e9t AI v\u00f2ng s\u00e0ng l\u1ecdc CV"
    },
    "cv_strengths": {
      "type": "string",
      "description": "\u0110i\u1ec3m m\u1ea1nh d\u1ef1a tr\u00ean b\u1eb1ng ch\u1ee9ng t\u1eeb CV"
    },
    "cv_gaps": {
      "type": "string",
      "description": "Kho\u1ea3ng tr\u1ed1ng / th\u00f4ng tin thi\u1ebfu ho\u1eb7c ch\u01b0a x\u00e1c minh"
    },
    "cv_quality_signals": {
      "type": "string",
      "description": "T\u00edn hi\u1ec7u ch\u1ea5t l\u01b0\u1ee3ng / \u0111\u00e1nh gi\u00e1 t\u00ednh x\u00e1c th\u1ef1c c\u1ee7a CV (ch\u1ec9 l\u00e0 t\u00edn hi\u1ec7u tham kh\u1ea3o, kh\u00f4ng ph\u1ea3i b\u1eb1ng ch\u1ee9ng l\u1eeba \u0111\u1ea3o)"
    },
    "hr_decision_reason": {
      "type": "string",
      "description": "L\u00fd do HR duy\u1ec7t/t\u1eeb ch\u1ed1i \u1edf v\u00f2ng 1"
    },
    "test_answer": {
      "type": "string",
      "description": "B\u00e0i l\u00e0m v\u00f2ng 2 (text/code)"
    },
    "test_started_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m b\u1eaft \u0111\u1ea7u l\u00e0m b\u00e0i thi (ISO)"
    },
    "test_submitted_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m n\u1ed9p b\u00e0i thi (ISO)"
    },
    "test_auto_submitted": {
      "type": "boolean",
      "default": false
    },
    "test_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m AI ch\u1ea5m b\u00e0i thi (0-100)"
    },
    "test_ai_analysis": {
      "type": "string",
      "description": "Nh\u1eadn x\u00e9t AI v\u00f2ng thi"
    },
    "interview_submitted_at": {
      "type": "string",
      "description": "Th\u1eddi \u0111i\u1ec3m ho\u00e0n th\u00e0nh ph\u1ecfng v\u1ea5n (ISO)"
    },
    "interview_ai_analysis": {
      "type": "string",
      "description": "Nh\u1eadn x\u00e9t AI ph\u1ecfng v\u1ea5n"
    },
    "interview_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m AI ph\u1ecfng v\u1ea5n (0-100)"
    },
    "final_notes": {
      "type": "string",
      "description": "Ghi ch\u00fa quy\u1ebft \u0111\u1ecbnh cu\u1ed1i c\u1ee7a h\u1ed9i \u0111\u1ed3ng"
    }
  },
  "required": [
    "job_id",
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}