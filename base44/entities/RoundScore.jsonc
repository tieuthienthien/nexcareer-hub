{
  "name": "RoundScore",
  "type": "object",
  "description": "\u0110i\u1ec3m c\u1ee7a t\u1eebng v\u00f2ng tuy\u1ec3n d\u1ee5ng: \u0111i\u1ec3m AI (tham kh\u1ea3o) v\u00e0 \u0111i\u1ec3m HR (ch\u00ednh th\u1ee9c, d\u00f9ng \u0111\u1ec3 x\u00e9t \u0111\u1ea1t/kh\u00f4ng \u0111\u1ea1t v\u00e0 chuy\u1ec3n v\u00f2ng).",
  "properties": {
    "application_id": {
      "type": "string",
      "description": "H\u1ed3 s\u01a1 \u1ee9ng vi\u00ean"
    },
    "round": {
      "type": "string",
      "enum": [
        "cv",
        "simulation",
        "interview"
      ],
      "description": "V\u00f2ng ch\u1ea5m \u0111i\u1ec3m: CV, Job Simulation, Ph\u1ecfng v\u1ea5n"
    },
    "ai_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m AI ch\u1ea5m t\u1ef1 \u0111\u1ed9ng (ch\u1ec9 tham kh\u1ea3o)"
    },
    "hr_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m HR ch\u1ea5m (ch\u00ednh th\u1ee9c, 0-100)"
    },
    "note": {
      "type": "string",
      "description": "Ghi ch\u00fa c\u1ee7a HR khi ch\u1ea5m \u0111i\u1ec3m"
    },
    "scored_by_email": {
      "type": "string"
    }
  },
  "required": [
    "application_id",
    "round"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}