{
  "name": "QuizAttempt",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "lesson_title": {
      "type": "string"
    },
    "chapter_index": {
      "type": "number"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "short",
              "mcq"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "points_awarded": {
            "type": "number"
          },
          "max_points": {
            "type": "number"
          },
          "feedback": {
            "type": "string"
          }
        }
      }
    },
    "score": {
      "type": "number"
    },
    "max_score": {
      "type": "number"
    },
    "percent": {
      "type": "number"
    },
    "ai_feedback": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "course_id",
    "lesson_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}