{
  "name": "CvJob",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00ean v\u1ecb tr\u00ed tuy\u1ec3n d\u1ee5ng"
    },
    "company": {
      "type": "string",
      "description": "T\u00ean c\u00f4ng ty tuy\u1ec3n d\u1ee5ng"
    },
    "category": {
      "type": "string",
      "description": "Ng\u00e0nh ngh\u1ec1 / l\u0129nh v\u1ef1c"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "full-time",
        "part-time",
        "contract",
        "intern"
      ],
      "default": "full-time"
    },
    "work_type": {
      "type": "string",
      "enum": [
        "remote",
        "hybrid",
        "onsite"
      ],
      "default": "onsite"
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "entry",
        "junior",
        "mid",
        "senior",
        "lead",
        "manager"
      ],
      "default": "mid"
    },
    "salary_min": {
      "type": "number",
      "description": "L\u01b0\u01a1ng t\u1ed1i thi\u1ec3u (tri\u1ec7u VND)"
    },
    "salary_max": {
      "type": "number",
      "description": "L\u01b0\u01a1ng t\u1ed1i \u0111a (tri\u1ec7u VND)"
    },
    "salary_negotiable": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "description": "M\u00f4 t\u1ea3 c\u00f4ng vi\u1ec7c"
    },
    "requirements": {
      "type": "string",
      "description": "Y\u00eau c\u1ea7u \u1ee9ng vi\u00ean"
    },
    "benefits": {
      "type": "string",
      "description": "Quy\u1ec1n l\u1ee3i"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vacancies": {
      "type": "number",
      "default": 1
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "H\u1ea1n nh\u1eadn h\u1ed3 s\u01a1"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "closed"
      ],
      "default": "published"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "is_nexora": {
      "type": "boolean",
      "default": false,
      "description": "Tin c\u1ee7a Nexora Technology \u2014 h\u1ed3 s\u01a1 \u1ee9ng tuy\u1ec3n \u0111\u1ed3ng b\u1ed9 sang NexCareer Hub"
    }
  },
  "required": [
    "title",
    "company"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}